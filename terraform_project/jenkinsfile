pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('YOUR_FIRST_CREDENTIAL_ID')
        AWS_SECRET_ACCESS_KEY = credentials('YOUR_SECOND_CREDENTIAL_ID')
    }

  
    stages {
        stage('terraform') {
            sh 'terraform version'
        }
    }

    stages {
        stage('Terraform') {
            steps {
                dir('ENV/dev') {
                    sh 'terraform init'
                    sh 'terraform plan'
                    sh 'terraform apply -auto-approve'
                }
            }
        }
    }
}
