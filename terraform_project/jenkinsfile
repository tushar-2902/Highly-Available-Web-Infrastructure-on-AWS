pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('YOUR_FIRST_CREDENTIAL_ID')
        AWS_SECRET_ACCESS_KEY = credentials('YOUR_SECOND_CREDENTIAL_ID')
    }

    stages {

        stage('Terraform Version') {
            steps {
                sh 'terraform version'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform_project/ENV/dev') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('ENV/dev') {
                    sh 'terraform plan'
                }
            }
        }


    }
}
